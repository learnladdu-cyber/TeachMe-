# PostgreSQL connection (Prisma Postgres, Neon, Supabase, or a local server).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# General app secret, also used to pseudonymise IPs/user-agents in security logs.
# REQUIRED in production: at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="change-me-generate-a-strong-random-secret-value"

# Public base URL used for links, metadata, cookies and callbacks.
# Use an https:// URL in production to enable secure, __Host- prefixed cookies.
APP_URL="http://localhost:3000"

# Security tuning.
SESSION_IDLE_MINUTES="480"
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_MINUTES="15"

# Secret required by the scheduled job endpoints (/api/cron/sla, /api/cron/billing,
# /api/cron/webhooks). Send it as `Authorization: Bearer <CRON_SECRET>` or the
# `x-cron-secret` header. Job endpoints return 503 when this is unset.
CRON_SECRET="change-me-generate-a-strong-random-secret-value"

# Optional: docs-grounded chat assistant LLM (OpenAI-compatible). Can also be
# configured from the admin Integrations panel instead of env.
# CHATBOT_LLM_URL="https://api.openai.com/v1/chat/completions"
# CHATBOT_LLM_KEY="sk-..."
# CHATBOT_LLM_MODEL="gpt-4o-mini"

# Transactional email via Resend (used as the nodemailer transport for email
# verification and admin sign-in codes). Takes priority over the SMTP settings
# configured in the admin Integrations panel.
# RESEND_API_KEY="re_..."
# RESEND_FROM="HelpDeskFlow <no-reply@yourdomain.com>"
