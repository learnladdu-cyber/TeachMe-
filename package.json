{
  "name": "helpdeskflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "security:audit": "npm audit --omit=dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "next": "^15.1.6",
    "nodemailer": "^10.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
